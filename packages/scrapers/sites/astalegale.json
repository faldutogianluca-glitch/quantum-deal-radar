{
  "name": "astalegale",
  "displayName": "Astalegale.net",
  "enabled": false,
  "priorita": 20,
  "fetchMode": "browser",
  "baseUrl": "https://www.astalegale.net",
  "searchUrl": "https://www.astalegale.net/ricerca-immobili-asta",
  "listSelector": ".search-result-item",
  "tipoPrezzo": "base_asta",
  "fields": {
    "titolo": ".title",
    "url": "a::attr(href)",
    "immagineUrl": "img::attr(src)",
    "prezzoRaw": ".price",
    "comune": ".location",
    "dataAstaRaw": ".auction-date",
    "sottotipoAsset": ".property-type"
  },
  "pagination": {
    "nextPageSelector": ".pagination .next",
    "maxPages": 5
  },
  "rateLimitSeconds": 5,
  "notes": "DISABILITATA. P2. Non era nella valutazione per fonte, ma resta in elenco: rispecchia parte dell'inventario BNL, il che la rende il banco di prova naturale della deduplica cross-fonte.",
  "browser": {
    "attendiSelettore": ".search-result-item",
    "timeoutMs": 30000
  },
  "ordineMonitoraggio": 21,
  "compliance": {
    "stato": "da_verificare",
    "note": "robots.txt e condizioni d'uso NON verificati: la policy di rete dell'ambiente di sviluppo impediva di raggiungere i siti."
  },
  "fascia": "P2"
}
