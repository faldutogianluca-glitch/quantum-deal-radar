node_modules/
dist/
# il DB e i suoi file di lavoro: -wal e -shm compaiono con SQLite in modalita' WAL,
# e il pattern precedente (*.db, *.db-journal) non li copriva
data/*.db*
# i portafogli consegnati a mano: dati di terzi, non vanno versionati
data/import/
data/zone_omi.geojson
data/quotazioni_omi.json
*.log
.env

# HyperFrames: snapshot, controlli e stato locale dello Studio
videos/*/.hyperframes/artifacts/
videos/*/.hyperframes/history-id
videos/*/.hyperframes/video-state*
videos/*/.hyperframes/render-outputs*

# Sorgenti avatar HeyGen (28 MB l'uno): si riscaricano dagli ID in BRIEF.md
videos/impegni-scritti-*/assets/avatar/*.mp4
__pycache__/
videos/pillole-tiktok-*/assets/avatar/*.mp4
