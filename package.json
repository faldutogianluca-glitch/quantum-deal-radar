{
  "name": "quantum-deal-radar",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @qdr/core -w @qdr/scrapers -w @qdr/server",
    "test": "npm run test -w @qdr/core -w @qdr/scrapers -w @qdr/server",
    "scrape": "npm run scrape --workspace=@qdr/server",
    "enrich": "npm run enrich --workspace=@qdr/server",
    "serve": "npm run serve --workspace=@qdr/server"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
